# Copy to `.env.local` for local development (never commit secrets).

# --- Public (inlined at build time; safe for browser) ---

# Mintlify API reference (Phase A: subdomain). Production default: https://docs.platform.narvo.news
NEXT_PUBLIC_DOCS_URL=https://docs.platform.narvo.news

# Canonical portal URL (metadata, OG). Production: https://platform.narvo.news
NEXT_PUBLIC_SITE_URL=https://platform.narvo.news

# B2B REST API base (playground + examples). Production: https://api.narvo.news
# Browser playground POSTs need CORS: API must allow this portal origin (e.g. localhost:3000, platform.narvo.news).
NEXT_PUBLIC_API_BASE_URL=https://api.narvo.news

# Status page JSON (GET). Omit to use same-origin /status-feed.json from public/.
# NEXT_PUBLIC_STATUS_FEED_URL=https://status.example.com/narvo.json

# Dashboard sandbox tiles / gauge / keys (GET). Omit to use same-origin /sandbox/dashboard.json from public/.
# NEXT_PUBLIC_DASHBOARD_SANDBOX_URL=https://api.example.com/portal/dashboard-sandbox.json

# Supabase — portal login & dashboard (Phase C). Anon key only in the browser (never service role).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server-only (when SSR/API routes exist; omit for static-only portal) ---
# SUPABASE_SERVICE_ROLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- Optional observability ---
# SENTRY_AUTH_TOKEN=
# NEXT_PUBLIC_SENTRY_DSN=
